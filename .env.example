# Copy this file to ".env" and fill in your keys.

# Alpha Vantage free API key (optional, for historical sentiment ~2022+)
# Get yours at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# OpenAI API key (optional, for AI Copilot chat panel in dashboard)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Twelve Data (optional) - automatic price fallback when yfinance fails.
# Free key: https://twelvedata.com (800 credits/day, 8 requests/min)
TWELVEDATA_API_KEY=your_twelvedata_key_here

# Trading212 Public API (optional, for the web app's Portfolio page)
# Generate in the T212 app: Settings -> API (Beta).
# SECURITY: grant READ scopes only — never order/trading permissions.
# T212_ENV: "live" (real account) or "demo" (paper trading)
T212_API_KEY=your_t212_key_id_here
T212_API_SECRET=your_t212_secret_here
T212_ENV=live

# Email alert (optional) — fired by scripts/daily_fetch.py (via
# scripts/portfolio_alerts.py) when a held position drops off the Signal
# Book. Requires a Gmail Account with 2-Step Verification and an App
# Password: https://myaccount.google.com/apppasswords (NOT your normal
# Gmail password — that will fail with an authentication error).
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
ALERT_EMAIL_TO=your_gmail_address@gmail.com
